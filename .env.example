# ==============================================================================
# IEI TVLC Staff Administration and Analytics Portal
# Environment Variables Template
# Copy this file to .env for local testing or enter these in Vercel Project Settings.
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 1. SECURITY & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
# Generate a strong 64-character random string (e.g., node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key_minimum_32_chars
SESSION_SECRET=replace_with_a_secure_session_secret_min_32_chars
COOKIE_NAME=iei_tvlc_token

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10

# ------------------------------------------------------------------------------
# 2. MANAGED POSTGRESQL DATABASE (Neon / Supabase / AWS RDS)
# ------------------------------------------------------------------------------
# Required for Vercel production deployment. When set, PostgreSQL is used;
# when unset, the app falls back to local JSON storage for local offline development.
DATABASE_URL=postgresql://username:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 3. OBJECT STORAGE (Supabase Storage for Vercel / Cloud Execution)
# ------------------------------------------------------------------------------
# Required for persistent file uploads in serverless environments.
# Create two buckets in Supabase Storage:
#  - 'iei-tvlc-posters' (Public bucket, image MIME types: jpeg, png, webp)
#  - 'iei-tvlc-reports' (Private bucket, document MIME types: pdf, docx, doc)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_POSTERS_BUCKET=iei-tvlc-posters
SUPABASE_REPORTS_BUCKET=iei-tvlc-reports

# ------------------------------------------------------------------------------
# 4. INITIAL SUPER ADMINISTRATOR SETUP
# ------------------------------------------------------------------------------
# Used when running: npm run admin:setup
ADMIN_EMAIL=admin@ieitvlc.org
ADMIN_PASSWORD=ChangeThisSecureAdminPassword2026!
ADMIN_NAME=IEI TVLC Chief Administrator
